# Secret key for BetterAuth (Use a strong, random secret)
BETTER_AUTH_SECRET=

# The base URL of your application (Update this for production)
BETTER_AUTH_URL=http://localhost:3000  # Change this to your production domain in deployment


# PostgreSQL Database Connection URL (Use environment variables in production)
DATABASE_URL="postgresql://<username>:<password>@<host>/<database_name>?sslmode=require"

NEXT_PUBLIC_SOCKET_URL=http://localhost:3001 # (Change this to your production socket server URL in deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000 # (Change this to your production app URL in deployment)

# Google OAuth Credentials (Required for social login)
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Media storage (for upload/serve endpoints)
# Max file size in bytes (default 10MB)
MEDIA_MAX_BYTES=10485760
# Directory to store uploaded media (relative or absolute)
MEDIA_STORAGE_DIR=public/media

# SMTP Configuration for Email Sending
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
