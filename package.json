{
  "name": "botify",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:reset": "bun --cwd packages/db db:migrate:reset",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "studio": "turbo run studio"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.1",
    "ts-jest": "^29.4.1",
    "turbo": "latest"
  },
  
  "dependencies": {
    "dotenv": "^17.2.2"
  }
}
