{
  "name": "@repo/types",
  "private": true,
  "scripts": {
    "dev": "tsup types.ts --watch",
    "build": "tsup types.ts --format cjs,esm --dts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js"
    }
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "ioredis": "^5.7.0",
    "libphonenumber-js": "^1.12.10",
    "zod": "^4.0.17"
  }
}
