      "require": "./dist/types.js"
    }
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.11",
    "zod": "^4.4.3"
  }
}
