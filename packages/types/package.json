{
  "name": "@repo/types",
  "private": true,
  "scripts": {
    "dev": "tsup types.ts",
    "build": "tsup types.ts --format cjs,esm --dts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.1"
  },
