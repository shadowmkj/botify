{
  "name": "@botify/socket",
  "module": "socket.ts",
  "scripts": {
    "build": "tsup server.ts --format cjs,esm --dts",
    "start": "DOTENV_CONFIG_PATH=../../.env node -r dotenv/config dist/server.js",
    "dev": " ts-node-dev -r dotenv/config --respawn --transpile-only server.ts",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/types": "workspace:*",
    "bullmq": "^5.70.1",
    "dotenv": "^17.3.1",
    "socket.io": "^4.8.3"
  }
}
